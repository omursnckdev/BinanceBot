# ============================================================
# GATE.IO FUTURES TRADING BOT - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!

# ============================================================
# SAFETY SETTINGS (CRITICAL)
# ============================================================
# Environment: testnet or mainnet
# ALWAYS start with testnet!
ENV=testnet

# Dry-run mode: if true, no actual orders are placed
# Keep this true until you're confident the bot works correctly
DRY_RUN=true

# Live trading gate: additional safety toggle
# Must be true to enable real trading on mainnet
# Even if ENV=mainnet and DRY_RUN=false, this must be true
ALLOW_LIVE_TRADING=false

# ============================================================
# GATE.IO API CREDENTIALS
# ============================================================
# For testnet, create keys at: https://fx-api-testnet.gateio.ws/
# For mainnet, create keys at: https://www.gate.io/myaccount/apiv4
# IMPORTANT: Enable futures permissions only

GATE_API_KEY=your_api_key_here
GATE_API_SECRET=your_api_secret_here

# ============================================================
# TRADING SYMBOLS
# ============================================================
# Comma-separated list of symbols to trade
# Default: BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# ============================================================
# NEWS SENTIMENT API (Optional)
# ============================================================
# CryptoPanic API: https://cryptopanic.com/developers/api/
# Get your free API key at: https://cryptopanic.com/developers/api/
# NewsAPI: https://newsapi.org/
# If not set, sentiment analysis will be disabled

# CryptoPanic API key (free tier available)
NEWS_API_KEY=your_cryptopanic_api_key_here

# Provider: "cryptopanic" or "newsapi"
# NEWS_PROVIDER=cryptopanic

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
LOG_JSON=true

# ============================================================
# RISK MANAGEMENT
# ============================================================
# Maximum daily loss before kill-switch activates (percentage)
# MAX_DAILY_LOSS_PCT=5.0

# Maximum consecutive losses before pause
# MAX_CONSECUTIVE_LOSSES=3

# Maximum open positions at once
# MAX_OPEN_POSITIONS=3

# Maximum total exposure as percentage of balance
# MAX_TOTAL_EXPOSURE_PCT=50.0

# Cooldown after a losing trade (seconds)
# COOLDOWN_AFTER_LOSS_SECONDS=300

# ============================================================
# SCALPING PROFILE - STOP-LOSS / TAKE-PROFIT
# ============================================================
# ATR multiplier for stop-loss calculation
# RISK__ATR_SL_MULTIPLIER=1.5

# Stop-loss range (percentage from entry)
# MIN_SL_PCT=0.6
# MAX_SL_PCT=0.9

# Take-profit range (percentage from entry)
# MIN_TP_PCT=1.0
# MAX_TP_PCT=2.0
# DEFAULT_TP_PCT=1.2

# Minimum Risk:Reward ratio
# TP_R_MULTIPLE=1.5

# ============================================================
# TIME-STOP (Scalping)
# ============================================================
# Close positions after this many minutes (0 = disabled)
# TIME_STOP_MINUTES=45

# ============================================================
# SPREAD/FEE AWARENESS
# ============================================================
# Maximum spread to trade (percentage)
# MAX_SPREAD_PCT=0.2

# Skip entries when spread exceeds this threshold (for scalping)
# SKIP_ENTRY_ON_HIGH_SPREAD=true
# SPREAD_ENTRY_THRESHOLD_PCT=0.05

# Minimum liquidity (USD) in order book
# MIN_LIQUIDITY_USD=50000

# ============================================================
# WHALE DETECTION
# ============================================================
# Enable/disable whale detection
# WHALE__ENABLED=true

# Defensive action when whale opposes position:
# CLOSE_MARKET, REDUCE_50_PERCENT, or TIGHTEN_STOP
# WHALE__DEFENSIVE_ACTION=CLOSE_MARKET

# Whale alert threshold (0.3 to 1.0)
# WHALE__WHALE_ALERT_THRESHOLD=0.7

# ============================================================
# MARGIN SETTINGS
# ============================================================
# Margin type: ISOLATED or CROSS
MARGIN_TYPE=ISOLATED
